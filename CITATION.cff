    family-names: Faulkner
    email: jake.faulkner@canterbury.ac.nz
    affiliation: University of Canterbury
repository-code: "https://github.com/ucgmsim/nzcvm"
url: "https://github.com/ucgmsim/nzcvm"
license: MIT
keywords:
  - seismology
  - velocity model
  - ground motion simulation
  - tetrahedral mesh
  - New Zealand
